# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
/.agents/*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/local-serve/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Chrome DevTools local profile (generated during testing, not part of source)
/chrome-profile/

# Design system & planning (AI-generated local docs, not source code)
/design-system/
/.planning/

# Local music cache
/music/

# Local scratch test scripts
/scripts/test_full_parse*.py
/public/images/auto_raja_sprite.jpg
